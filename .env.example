# Environment Variables
# Copy this file to .env.local and fill in your values

# NOTE: The following feature keys were removed/disabled by request:
# - MongoDB connection (DATABASE_URL)
# - Stripe keys (STRIPE_PUBLIC_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET)
# - OTP / SMS provider keys (e.g., Twilio)
# - Email OTP provider key (RESEND_API_KEY)
# - Gmail/Google OAuth keys (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET)
# - Forgot-password email flow keys (if implemented separately)
# If you need any of these features later, re-add the appropriate keys below.

# SITE & APP CONFIGURATION
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_MIN_AGE="21"

# Authentication (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# OAuth Providers (Optional)
# Google/Gmail login has been disabled per request. To re-enable, add your keys here:
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth (left in place)
GITHUB_ID="your-github-id"
GITHUB_SECRET="your-github-secret"

# Payment Processing
# Stripe integration removed per request. To re-enable, add Stripe keys below:
# STRIPE_PUBLIC_KEY="pk_live_..."
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox" # or 'live'

# Email Service
# Resend (email OTP) removed per request. To re-enable, add the API key below:
# RESEND_API_KEY="re_..."
FROM_EMAIL="noreply@hookha-shop.com"
SUPPORT_EMAIL="support@hookha-shop.com"

# Image Storage (Cloudinary)
NEXT_PUBLIC_CLOUDINARY_BASE_URL="https://res.cloudinary.com/your-cloud-name/image/upload/"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Analytics (Optional)
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
MATOMO_SITE_ID="1"
MATOMO_URL="https://matomo.example.com"

# Admin Configuration
ADMIN_EMAIL="admin@hookha-shop.com"
ADMIN_PASSWORD="your-admin-password"

# Feature Flags
ENABLE_WHOLESALE="true"
ENABLE_REVIEWS="true"
ENABLE_WISHLIST="true"
ENABLE_3D_MODELS="false"

# Shipping & Tax
DEFAULT_CURRENCY="USD"
TAX_RATE="0.1"
FREE_SHIPPING_THRESHOLD="100"

# API Configuration
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
API_TIMEOUT="30000"

# Logging
LOG_LEVEL="info"
ENABLE_DEBUG="false"
