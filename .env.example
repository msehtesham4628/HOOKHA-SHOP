# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hookah_shop"

# Authentication
AUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Image Storage (Choose one: Cloudinary, S3, or Vercel Blob)
# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# AWS S3
S3_ENDPOINT="https://s3.amazonaws.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_BUCKET="hookah-shop-bucket"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="your-blob-token"

# Email Provider (Resend or alternatives)
RESEND_API_KEY="your-resend-api-key"

# Site Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Admin Configuration
NEXT_PUBLIC_MIN_AGE="21"

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID="your-analytics-id"
