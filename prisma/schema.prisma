// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String? // For email/password auth
  emailVerified DateTime?
  image         String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
  wishlist      Wishlist[]
  reviews       Review[]
  wholesaleProfile WholesaleCustomer?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum UserRole {
  CUSTOMER
  WHOLESALE
  ADMIN
  SUPER_ADMIN
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// CATEGORIES & BRANDS
// ============================================================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  icon        String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  parentId    String?
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  logo        String?
  website     String?
  products    Product[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================================
// PRODUCTS
// ============================================================================

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  sku             String   @unique
  description     String?
  shortDescription String?
  
  // Pricing
  price           Float
  salePrice       Float?
  currency        String   @default("USD")
  
  // Relationships
  brandId         String
  brand           Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  // Product Details
  weight          Float?
  dimensions      String? // JSON string: {length, width, height}
  material        String?
  color           String?
  flavor          String? // For tobacco
  specifications  String? // JSON string
  
  // Media & 3D
  images          ProductImage[]
  model3DUrl      String?
  model3DEnabled  Boolean  @default(false)
  
  // Inventory
  stock           Int      @default(0)
  reserved        Int      @default(0)
  lowStockThreshold Int    @default(10)
  
  // Metadata
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  tags            String[] // Array of tags
  
  // Status
  status          ProductStatus @default(DRAFT)
  isFeatured      Boolean  @default(false)
  isNew           Boolean  @default(true)
  isBestseller    Boolean  @default(false)
  
  // Relations
  orderItems      OrderItem[]
  reviews         Review[]
  wishlist        Wishlist[]
  variants        ProductVariant[]
  inventory       Inventory?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  DISCONTINUED
}

model ProductImage {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  imageUrl      String   // CDN URL
  localStorageUrl String? // Local backup URL
  altText       String?
  sortOrder     Int      @default(0)
  isPrimary     Boolean  @default(false)
  imageType     String   @default("product") // product, lifestyle, packaging, detail
  
  width         Int?
  height        Int?
  fileSize      Int?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  name        String
  sku         String   @unique
  price       Float?
  salePrice   Float?
  stock       Int      @default(0)
  
  attributes  String? // JSON string: {size, color, etc}
  image       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inventory {
  id              String   @id @default(cuid())
  productId       String   @unique
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  totalStock      Int      @default(0)
  reserved        Int      @default(0)
  available       Int      @default(0)
  lowStockThreshold Int    @default(10)
  
  lastRestockDate DateTime?
  nextRestockDate DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// ORDERS & PAYMENTS
// ============================================================================

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  items           OrderItem[]
  
  // Pricing
  subtotal        Float
  tax             Float    @default(0)
  shippingCost    Float    @default(0)
  discount        Float    @default(0)
  total           Float
  
  // Coupon
  couponId        String?
  coupon          Coupon?  @relation(fields: [couponId], references: [id])
  
  // Shipping
  shippingMethod  String?
  shippingId      String?
  shipping        Shipping? @relation(fields: [shippingId], references: [id])
  
  // Addresses
  billingAddress  Address?  @relation("BillingAddress", fields: [billingAddressId], references: [id])
  billingAddressId String?
  
  shippingAddress Address?  @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  shippingAddressId String?
  
  // Status
  status          OrderStatus @default(PENDING)
  payment         Payment?
  
  // Customer Info
  email           String
  phone           String?
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PAYMENT_PROCESSING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  
  quantity        Int
  price           Float    // Price at time of purchase
  subtotal        Float
  
  // Variant details if applicable
  variantId       String?
  variantDetails  String? // JSON
  
  createdAt       DateTime @default(now())
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  amount          Float
  currency        String   @default("USD")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  
  // Payment Provider Details
  providerName    String   @default("stripe")
  transactionId   String?
  paymentIntentId String?
  
  // Metadata
  metadata        String?  // JSON
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  BANK_TRANSFER
  CRYPTO
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model Shipping {
  id              String   @id @default(cuid())
  name            String
  description     String?
  
  basePrice       Float
  perItemPrice    Float    @default(0)
  perWeightPrice  Float    @default(0)
  
  estimatedDays   Int
  maxWeight       Float?
  
  countries       String[] // Array of country codes
  
  isActive        Boolean  @default(true)
  
  orders          Order[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// ADDRESSES
// ============================================================================

model Address {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  firstName       String
  lastName        String
  email           String?
  phone           String?
  
  country         String
  state           String?
  city            String
  street          String
  apartment       String?
  postalCode      String
  
  isDefault       Boolean  @default(false)
  type            AddressType @default(SHIPPING)
  
  billingOrders   Order[]  @relation("BillingAddress")
  shippingOrders  Order[]  @relation("ShippingAddress")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

// ============================================================================
// REVIEWS
// ============================================================================

model Review {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating          Int      // 1-5
  title           String?
  content         String?
  
  verified        Boolean  @default(false)
  helpful         Int      @default(0)
  
  images          String[] // Array of image URLs
  
  status          ReviewStatus @default(PENDING)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// WISHLIST
// ============================================================================

model Wishlist {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  
  @@unique([userId, productId])
}

// ============================================================================
// COUPONS & PROMOTIONS
// ============================================================================

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String?
  
  type            CouponType
  value           Float    // Percentage or fixed amount
  
  minOrderAmount  Float    @default(0)
  maxDiscount     Float?   // Max discount for percentage coupons
  
  usageLimit      Int?     // Total uses allowed
  usageCount      Int      @default(0)
  usagePerUser    Int      @default(1)
  
  applicableCategories String[]    // Empty = all categories
  applicableProducts   String[]    // Empty = all products
  applicableBrands     String[]    // Empty = all brands
  
  startDate       DateTime
  expiryDate      DateTime
  
  isActive        Boolean  @default(true)
  
  orders          Order[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

// ============================================================================
// WHOLESALE
// ============================================================================

model WholesaleCustomer {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  businessName    String
  businessType    String?
  registrationNumber String?
  taxId           String?
  
  status          WholesaleStatus @default(PENDING)
  
  minOrderQuantity Int      @default(100)
  discountPercentage Float  @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum WholesaleStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// ============================================================================
// SETTINGS & ADMIN
// ============================================================================

model SiteSettings {
  id              String   @id @default(cuid())
  
  siteName        String   @default("Hookah Shop")
  siteUrl         String
  minAge          Int      @default(21)
  
  // Contact
  email           String
  phone           String?
  address         String?
  
  // Currency
  currency        String   @default("USD")
  
  // Shipping
  freeShippingThreshold Float?
  
  // Email
  emailProvider   String   @default("resend")
  
  // Storage
  storageProvider String   @default("cloudinary")
  
  // Features
  enableWholesale Boolean  @default(true)
  enableReviews   Boolean  @default(true)
  enableWishlist  Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id              String   @id @default(cuid())
  action          String
  entity          String
  entityId        String
  changes         String?  // JSON
  
  userId          String?
  userEmail       String?
  
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime @default(now())
}
